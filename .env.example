# ==========================================
# MCP 服务配置
# ==========================================
# HowToCook MCP 服务地址（腾讯云 Serverless 部署）
MCP_BASE_URL=https://your-mcp-service-url.com


# AI 模型和 API Key 请在应用内“模型管理”页面添加，仅保存在本机。
